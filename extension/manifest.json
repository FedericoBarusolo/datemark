{
  "manifest_version": 3,
  "name": "Datemark - Extract Events from Web Pages with AI",
  "short_name": "Datemark",
  "version": "1.0.5",
  "description": "AI-powered tool to automatically extract events from any webpage and add them to Google Calendar in seconds.",
  "permissions": [
    "identity",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://datemark-852615838189.europe-west1.run.app/*"
  ],
  "oauth2": {
    "client_id": "852615838189-gdc9n4r9l3k48202o9f556v1ct4rjtor.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.events",
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "datemark.html",
    "default_icon": "icons/icon.png"
  }
}